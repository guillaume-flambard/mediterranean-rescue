{
  "name": "@mediterranean-rescue/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "check:generated": "pnpm codegen && git diff --exit-code -- src/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "^5.104.5",
    "maplibre-gl": "6.15.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  }
}
